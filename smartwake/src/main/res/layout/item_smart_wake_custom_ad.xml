<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/smartwake_ad_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/smartwake_desc_icon"
            android:src="@drawable/ic_smartwake_lock" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/smartwake_ad_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/smartwake_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Special Offer" />

            <TextView
                android:id="@+id/smartwake_ad_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/smartwake_text_secondary"
                android:textSize="12sp"
                tools:text="Discover amazing features in our app!" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/smartwake_ad_cta"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:text="@string/smartwake_app_name"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
