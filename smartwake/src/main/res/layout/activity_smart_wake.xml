<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smartwake_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smartwake_bg_overlay">

    <!-- ViewPager2 for Horizontal Wallpaper Scrolling -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/smartwake_wallpaper_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Main Container Layout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- Clock and Weather Header -->
        <LinearLayout
            android:id="@+id/smartwake_clock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/smartwake_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/smartwake_text_primary"
                android:textSize="48sp"
                android:textStyle="bold"
                tools:text="10:45 AM" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/smartwake_text_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE, MMM d"
                    android:format24Hour="EEE, MMM d"
                    android:textColor="@color/smartwake_text_secondary"
                    android:textSize="14sp"
                    tools:text="Mon, Nov 20" />

                <TextView
                    android:id="@+id/smartwake_tv_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/smartwake_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text=" • Sunny 29°C" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Overlay Card Container (Center Dialog) -->
        <LinearLayout
            android:id="@+id/smartwake_card_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_smartwake_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Quotes View -->
            <TextView
                android:id="@+id/smartwake_tv_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/smartwake_text_primary"
                android:textSize="16sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="“Believe you can and you are halfway there.”" />

            <!-- News / Sports Feed View -->
            <TextView
                android:id="@+id/smartwake_tv_news_sports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/smartwake_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="IND 245/4 (42.2 ov) vs AUS" />

            <!-- Native Ad Container -->
            <FrameLayout
                android:id="@+id/smartwake_ad_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Read More Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/smartwake_btn_read_more"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Read More ›"
                android:textColor="@color/smartwake_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Bottom Swipe Indicator -->
        <LinearLayout
            android:id="@+id/smartwake_swipe_hint_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/smartwake_swipe_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/smartwake_desc_swipe_icon"
                android:src="@drawable/ic_smartwake_swipe_up" />

            <TextView
                android:id="@+id/smartwake_swipe_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/smartwake_swipe_hint"
                android:textColor="@color/smartwake_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
