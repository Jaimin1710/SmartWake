<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smartwake_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ViewPager2 for Wallpapers (Full Screen Mode) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/smartwake_wallpaper_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Main Container Layout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Clock and Weather Header (Top) -->
        <LinearLayout
            android:id="@+id/smartwake_clock_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/smartwake_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="68sp"
                android:textStyle="bold"
                tools:text="12:53" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/smartwake_text_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE, MMM d"
                    android:format24Hour="EEE, MMM d"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Sun, Nov 22" />

                <TextView
                    android:id="@+id/smartwake_tv_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text=" • 30°C (Clear &amp; Sunny)" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Overlay Card Container (Center Dialog) -->
        <LinearLayout
            android:id="@+id/smartwake_card_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:minHeight="140dp"
            android:background="@drawable/bg_smartwake_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Quotes View -->
            <TextView
                android:id="@+id/smartwake_tv_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/smartwake_text_primary"
                android:textSize="15sp"
                android:textStyle="italic"
                android:visibility="gone"
                tools:text="“Believe you can and you are halfway there.”" />

            <!-- News / Sports Feed View -->
            <TextView
                android:id="@+id/smartwake_tv_news_sports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/smartwake_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="IND 245/4 (42.2 ov) vs AUS" />

            <!-- Native Ad Container -->
            <FrameLayout
                android:id="@+id/smartwake_ad_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <!-- Read More Button -->
            <TextView
                android:id="@+id/smartwake_btn_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/smartwake_btn_read_more"
                android:textColor="@color/smartwake_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Bottom Flashlight Shortcut (Bottom Left) -->
        <ImageView
            android:id="@+id/smartwake_btn_flashlight"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_smartwake_shortcut"
            android:clickable="true"
            android:contentDescription="@string/smartwake_app_name"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_smartwake_flashlight" />

        <!-- Bottom Camera Shortcut (Bottom Right) -->
        <ImageView
            android:id="@+id/smartwake_btn_camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_smartwake_shortcut"
            android:clickable="true"
            android:contentDescription="@string/smartwake_app_name"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_smartwake_camera" />

        <!-- Bottom Swipe Indicator (Center Bottom) -->
        <LinearLayout
            android:id="@+id/smartwake_swipe_hint_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/smartwake_swipe_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/smartwake_desc_swipe_icon"
                android:src="@drawable/ic_smartwake_swipe_up" />

            <TextView
                android:id="@+id/smartwake_swipe_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/smartwake_swipe_hint"
                android:textColor="@color/smartwake_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
